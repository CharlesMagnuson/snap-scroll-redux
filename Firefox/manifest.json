{
  "manifest_version": 3,
  "name": "Snap Scroll Redux",
  "version": "1.1.1",
  "description": "Advanced scrolling: Hold left + right-click to snap scroll, middle-click paragraphs to jump to next",
  
  "browser_specific_settings": {
    "gecko": {
      "id": "snapscrollredux@example.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  
  "permissions": [
    "activeTab"
  ],
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["browser-polyfill.min.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "Snap Scroll Redux"
  }
}